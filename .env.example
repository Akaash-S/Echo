# ===========================================================================
# Echo Backend Environment Configuration Template
# ===========================================================================

# Gemini AI API Key (obtain from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Backend & Frontend URLs
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Firebase Project & Admin SDK Service Account
FIREBASE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# ===========================================================================
# Echo Frontend Firebase Client Configuration (Vite)
# ===========================================================================
# Obtain from Firebase Console -> Project Settings -> General -> Your apps

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
